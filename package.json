{
  "name": "chatgpt-companion",
  "productName": "ChatGPT Companion",
  "version": "1.0.0",
  "description": "Small frameless translucent window with ChatGPT Temporary Chat",
  "main": "build/main.js",
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run compile",
    "start": "electron .",
    "prebuild": "npm run compile",
    "build": "electron-builder --win",
    "prebuild:portable": "npm run compile",
    "build:portable": "node scripts/build-portable.js",
    "prebuild:dir": "npm run compile",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.local.chatgpt-companion",
    "productName": "ChatGPT Companion",
    "files": [
      "build/**/*",
      "main.js",
      "package.json",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "assets/icon.png",
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "portable"
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
